# Environment Configuration for Landslide Prevention System
# Copy this file to .env and fill in your actual values

# ==========================================
# SERVER & DATABASE
# ==========================================
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/landslide_prevention
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# ==========================================
# DATA SOURCES - NASA EONET
# ==========================================
NASA_EONET_ENABLED=true
NASA_EONET_API=https://eonet.gsfc.nasa.gov/api/v3/events
NASA_EONET_TIMEOUT=10000
NASA_EONET_CATEGORY=14  # Landslide category code

# ==========================================
# DATA SOURCES - ReliefWeb
# ==========================================
RELIEFWEB_ENABLED=true
RELIEFWEB_API=https://reliefweb.int/api/v1/disasters
RELIEFWEB_TIMEOUT=15000
RELIEFWEB_COUNTRY=IN  # Filter for India

# ==========================================
# DISASTER SYNC CONFIGURATION
# ==========================================
ENABLE_DISASTER_SYNC=true
DISASTER_SYNC_INTERVAL=21600000  # 6 hours in milliseconds (6 * 60 * 60 * 1000)
DISASTER_DEDUP_RADIUS=50  # km - events within this distance are considered duplicates
DISASTER_DEDUP_DAYS=7     # days - events within this date range are considered duplicates
DISASTER_FALLBACK_ENABLED=true  # Use fallback data if APIs fail

# ==========================================
# PRIORITY WEIGHTS (for data ranking)
# ==========================================
RELIEFWEB_PRIORITY=0.60   # ReliefWeb gets 60% priority (verified)
NASA_PRIORITY=0.40        # NASA gets 40% priority (real-time)

# ==========================================
# ML SERVICE CONFIGURATION
# ==========================================
# ML Service URL - FastAPI service running on port 8001
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=30000  # 30 seconds timeout for ML predictions
ML_SERVICE_HEALTH_CHECK_INTERVAL=60000  # Check health every 60 seconds
ML_SERVICE_ENABLED=true  # Enable/disable ML service integration

# Model weights for prediction combination
API_WEIGHT=0.50       # 50% weight for API data (weather, earthquakes, etc.)
ML_WEIGHT=0.40        # 40% weight for ML model predictions
HISTORICAL_WEIGHT=0.10 # 10% weight for historical data

# ML Model Configuration
ENABLE_AUTO_RETRAIN=true
ML_MODEL_PATH=./ml-service/models/landslide_risk_pipeline.pkl
PYTHON_SHELL_PATH=/usr/bin/python3

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_DIR=./server/logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14  # 2 weeks of logs

# ==========================================
# API RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# MONITORING & ALERTS
# ==========================================
ENABLE_MONITORING=true
CATASTROPHIC_EVENT_ALERT=true
ALERT_EMAIL=admin@geoshield.com

# ==========================================
# CACHE SETTINGS (Redis - optional)
# ==========================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600  # 1 hour

# ==========================================
# FEATURES
# ==========================================
ENABLE_REAL_TIME_ALERTS=true
ENABLE_ANALYTICS=true
ENABLE_USER_REPORTS=true
