# ====================================================================
# GeoShield AI - ML Service Configuration
# ====================================================================

# Application Settings
APP_NAME=GeoShield AI ML Service
ENVIRONMENT=development
DEBUG=True
VERSION=3.2.0

# Server Configuration
HOST=0.0.0.0
PORT=8001
WORKERS=4

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,https://geoshield.ai

# Database (PostgreSQL for GIS data)
DATABASE_URL=postgresql://geoshield:geoshield123@localhost:5432/geoshield_gis
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Cache (Redis)
REDIS_URL=redis://:redis123@localhost:6379/0
REDIS_POOL_SIZE=10
CACHE_TTL=3600

# Model Registry and Storage
MODEL_REGISTRY_PATH=./models
MODEL_VERSION=production
MODEL_CACHE_SIZE=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ml-service.log

# Feature Engineering
FEATURE_ENGINEERING_ENABLED=True
FEATURE_SCALING=standard

# Model Training Configuration
ENABLE_MODEL_RETRAINING=False
RETRAIN_SCHEDULE=0 0 * * 0  # Weekly on Sunday at midnight

# Performance Tuning
MAX_BATCH_SIZE=1000
PREDICTION_TIMEOUT=30
CACHE_PREDICTIONS=True

# Optional: External Services
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=landslide_prediction

# Optional: Object Storage (MinIO/S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=geoshield-models
MINIO_SECURE=False
